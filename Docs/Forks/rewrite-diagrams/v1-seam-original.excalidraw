      "isDeleted": false,
      "boundElements": null,
      "updated": 1786675575730,
      "link": null,
      "locked": false,
      "text": "Each child owns one PKCanvasView and is blind to page numbers.",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Each child owns one PKCanvasView and is blind to page numbers.",
      "autoResize": true,
      "lineHeight": 1.15,
      "syncedAt": "2026-08-14T02:53:26.615Z",
      "source": "frontend_sync",
      "syncTimestamp": "2026-08-14T02:53:26.609Z"
    },
    {
      "id": "note3",
      "type": "text",
      "x": 680,
      "y": 587,
      "width": 464.150390625,
      "height": 17.25,
      "angle": 0,
      "strokeColor": "#2b8a3e",
      "backgroundColor": "transparent",
