      "text": "Bounded window: a few live canvases, never grows with page count.",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bounded window: a few live canvases, never grows with page count.",
      "autoResize": true,
      "lineHeight": 1.15,
      "syncedAt": "2026-08-14T02:53:26.615Z",
      "source": "frontend_sync",
      "syncTimestamp": "2026-08-14T02:53:26.609Z"
    },
    {
      "id": "note2",
      "type": "text",
      "x": 680,
      "y": 561,
      "width": 445.83251953125,
      "height": 17.25,
      "angle": 0,
      "strokeColor": "#2b8a3e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
