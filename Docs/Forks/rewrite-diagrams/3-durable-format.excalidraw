    {
      "id": "a1",
      "type": "text",
      "x": 1080,
      "y": 190,
      "width": 235.11572265625,
      "height": 52.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aO",
      "roundness": null,
      "seed": 372548157,
      "version": 1,
      "versionNonce": 1888324573,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786678647690,
      "link": null,
      "locked": false,
      "text": "a refusal is the page's, never the\nbatch's — no page holds another's\nink hostage",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "a refusal is the page's, never the\nbatch's — no page holds another's\nink hostage",
      "autoResize": true,
      "lineHeight": 1.25,
      "syncedAt": "2026-08-14T03:37:29.661Z",
      "source": "frontend_sync",
      "syncTimestamp": "2026-08-14T03:37:29.659Z"
    },
    {
      "id": "a2",
      "type": "text",
      "x": 1080,
      "y": 330,
      "width": 231.6717071533203,
      "height": 52.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aP",
      "roundness": null,
      "seed": 244018195,
      "version": 1,
      "versionNonce": 1372023923,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786678647690,
      "link": null,
      "locked": false,
      "text": "a crash in here leaves orphan files\nthe index never names — invisible,\nnever a dangling reference",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "a crash in here leaves orphan files\nthe index never names — invisible,\nnever a dangling reference",
      "autoResize": true,
      "lineHeight": 1.25,
      "syncedAt": "2026-08-14T03:37:29.661Z",
      "source": "frontend_sync",
      "syncTimestamp": "2026-08-14T03:37:29.659Z"
    },
    {
      "id": "a3",
      "type": "text",
      "x": 1080,
      "y": 528,
      "width": 242.70370483398438,
      "height": 35,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aQ",
      "roundness": null,
      "seed": 54481565,
      "version": 1,
      "versionNonce": 571082813,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786678647690,
      "link": null,
      "locked": false,
      "text": "the leaf→root ordering holds under\npower loss, not only process crash",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "the leaf→root ordering holds under\npower loss, not only process crash",
      "autoResize": true,
      "lineHeight": 1.25,
      "syncedAt": "2026-08-14T03:37:29.661Z",
      "source": "frontend_sync",
      "syncTimestamp": "2026-08-14T03:37:29.659Z"
    },
    {
      "id": "a4",
      "type": "text",
      "x": 1080,
      "y": 648,
      "width": 233.89772033691406,
      "height": 35,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aR",
      "roundness": null,
      "seed": 1359638963,
