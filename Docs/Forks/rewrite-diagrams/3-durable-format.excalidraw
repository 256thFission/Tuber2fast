      "versionNonce": 1638360595,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786678647690,
      "link": null,
      "locked": false,
      "text": "withheld only by its own failure —\na refused page can never wedge it",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "withheld only by its own failure —\na refused page can never wedge it",
      "autoResize": true,
      "lineHeight": 1.25,
      "syncedAt": "2026-08-14T03:37:29.661Z",
      "source": "frontend_sync",
      "syncTimestamp": "2026-08-14T03:37:29.659Z"
    },
    {
      "id": "readrule1",
      "type": "text",
      "x": 60,
      "y": 760,
      "width": 1085.921875,
      "height": 18.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aS",
      "roundness": null,
      "seed": 1884616445,
      "version": 1,
      "versionNonce": 2071459997,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786678647690,
      "link": null,
      "locked": false,
      "text": "Reading: version ≠ current → refuse by number · version = current with a key missing → refuse naming the key · no silent defaults over durable facts",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Reading: version ≠ current → refuse by number · version = current with a key missing → refuse naming the key · no silent defaults over durable facts",
      "autoResize": true,
      "lineHeight": 1.25,
      "syncedAt": "2026-08-14T03:37:29.661Z",
      "source": "frontend_sync",
      "syncTimestamp": "2026-08-14T03:37:29.659Z"
    },
    {
      "id": "readrule2",
      "type": "text",
      "x": 60,
      "y": 788,
      "width": 915.5094604492188,
      "height": 18.75,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aT",
      "roundness": null,
      "seed": 618120019,
      "version": 1,
      "versionNonce": 311897011,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786678647690,
      "link": null,
      "locked": false,
      "text": "Every durable type's exact key set is pinned by a test beside the format version — changing one without the other fails CI.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Every durable type's exact key set is pinned by a test beside the format version — changing one without the other fails CI.",
      "autoResize": true,
      "lineHeight": 1.25,
      "syncedAt": "2026-08-14T03:37:29.661Z",
      "source": "frontend_sync",
      "syncTimestamp": "2026-08-14T03:37:29.659Z"
    },
